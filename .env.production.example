# Production Environment Configuration
# Copy to .env for production: cp .env.production.example .env
# Then edit with your actual values
# NOTE: this template is tracked, the real .env is not — never put secrets in here.

# App
NODE_ENV=production
APP_PORT=3000

# Database (Docker internal network)
MONGODB_URI=mongodb://mongo:27017/e-learning-msc

# Auth - GENERATE A STRONG SECRET: openssl rand -base64 32
AUTH_SECRET=your-production-secret-min-32-chars
AUTH_URL=https://e-teaching.tech
AUTH_TRUST_HOST=true

# OAuth (optional - only needed if using Google/GitHub login)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Domain for nginx SSL config
DOMAIN=e-teaching.tech

# RustFS (S3-compatible object storage) - images & media
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=e-learning-msc
RUSTFS_ACCESS_KEY=elearningfsadmin
RUSTFS_SECRET_KEY=elearningfsadmin-secret
RUSTFS_REGION=us-east-1

# Docker Compose ports
HTTP_PORT=80
HTTPS_PORT=443
ME_PORT=8585
ME_USER=admin
ME_PASSWORD=change-this-password

# AI (Ollama) — local LLM inference
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=phi4-mini
AI_PROVIDER=ollama

# Visitor analytics (first-party, /admin/analytics)
# IPstack — server-only. NEVER prefix with NEXT_PUBLIC_. Rotate via the APILayer dashboard.
IPSTACK_ACCESS_KEY=
IPSTACK_BASE_URL=https://api.ipstack.com
IPSTACK_TIMEOUT_MS=3000
IPSTACK_CACHE_TTL_HOURS=168
IPSTACK_FAILURE_BACKOFF_MINUTES=60
ANALYTICS_ENABLED=true
# HMAC key for pseudonymous visitor/IP hashing. Falls back to AUTH_SECRET when empty.
ANALYTICS_HASH_SECRET=
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_SESSION_WINDOW_MINUTES=30
ANALYTICS_REPORTING_TZ=UTC
ANALYTICS_EXCLUDE_ADMINS=true
ANALYTICS_TRUST_PROXY=true
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
ANALYTICS_MAX_EVENTS_PER_REQUEST=10
ANALYTICS_MAX_BODY_BYTES=16384
ANALYTICS_MAX_RANGE_DAYS=90
