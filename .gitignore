# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# env files
# `.env.example` is the ONLY tracked env file — it is the documented reference for
# every variable. Real files are `.env.local` (dev) and `.env` (docker compose /
# VPS), both gitignored. Tracking a real env file is what previously made
# `git pull` abort on the VPS with "local changes would be overwritten".
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Belt and braces: refuse any stray file that looks like a real IPstack key.
*.env
!*.env.example
# vercel
.vercel

# docker compose overrides (local overrides only)
docker-compose.override.yml

# typescript
*.tsbuildinfo
next-env.d.ts


package-lock.json

/public/uploads/*
nginx/ssl/

./vscode/*