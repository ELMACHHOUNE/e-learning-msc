# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Only the `*.example` templates are tracked. Every other env file may hold real
# secrets (AUTH_SECRET, OAuth client secrets, IPSTACK_ACCESS_KEY) and must never be
# committed — a tracked `.env.production` silently blocks `git pull` on the VPS.
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
!.env.development.example
!.env.production.example

# Belt and braces: refuse any stray file that looks like a real IPstack key.
*.env
!*.env.example
# vercel
.vercel

# docker compose overrides (local overrides only)
docker-compose.override.yml

# typescript
*.tsbuildinfo
next-env.d.ts


package-lock.json

/public/uploads/*
nginx/ssl/
