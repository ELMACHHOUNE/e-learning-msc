# Production Environment Configuration
# Copy to .env for production: cp .env.production .env
# Then edit with your actual values

# App
NODE_ENV=production
APP_PORT=3000

# Database (Docker internal network)
MONGODB_URI=mongodb://mongo:27017/e-learning-msc

# Auth - GENERATE A STRONG SECRET: openssl rand -base64 32
AUTH_SECRET=your-production-secret-min-32-chars
AUTH_URL=https://e-teaching.tech
AUTH_TRUST_HOST=true

# OAuth (optional - only needed if using Google/GitHub login)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Domain for nginx SSL config
DOMAIN=e-teaching.tech

# RustFS (S3-compatible object storage) - images & media
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=e-learning-msc
RUSTFS_ACCESS_KEY=elearningfsadmin
RUSTFS_SECRET_KEY=elearningfsadmin-secret
RUSTFS_REGION=us-east-1

# Docker Compose ports
HTTP_PORT=80
HTTPS_PORT=443
ME_PORT=8585
ME_USER=admin
ME_PASSWORD=change-this-password