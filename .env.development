# Development Environment Configuration
# Copy to .env.local for local development: cp .env.development .env.local

# App
NODE_ENV=development
APP_PORT=3000

# Database (local MongoDB or Docker)
MONGODB_URI=mongodb://localhost:27017/e-learning-msc

# Auth
AUTH_SECRET=dev-secret-key-change-in-production-min-32-chars
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# OAuth (optional - only needed if using Google/GitHub login)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Seed
SEED_PASSWORD=password123

# RustFS (S3-compatible object storage) - images & media
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=e-learning-msc
RUSTFS_ACCESS_KEY=elearningfsadmin
RUSTFS_SECRET_KEY=elearningfsadmin-secret
RUSTFS_REGION=us-east-1

# Docker Compose (for docker-compose.dev.yml)
HTTP_PORT=80
ME_PORT=8585
ME_USER=admin
ME_PASSWORD=admin
# Windows/Docker reserves the 8926-9025 band, so RustFS host ports are mapped off it
RUSTFS_S3_PORT=9200
RUSTFS_CONSOLE_PORT=9201


# AI (Ollama) — local LLM inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini
AI_PROVIDER=ollama

# Visitor analytics (first-party, /admin/analytics) — leave the key empty locally to run without geolocation
IPSTACK_ACCESS_KEY=
IPSTACK_BASE_URL=https://api.ipstack.com
IPSTACK_TIMEOUT_MS=3000
IPSTACK_CACHE_TTL_HOURS=168
IPSTACK_FAILURE_BACKOFF_MINUTES=60
ANALYTICS_ENABLED=true
ANALYTICS_HASH_SECRET=
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_SESSION_WINDOW_MINUTES=30
ANALYTICS_REPORTING_TZ=UTC
ANALYTICS_EXCLUDE_ADMINS=true
ANALYTICS_TRUST_PROXY=false
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
