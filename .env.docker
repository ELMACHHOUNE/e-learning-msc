# Copy to `.env` for docker compose:  cp .env.docker .env
APP_PORT=3000
HTTP_PORT=80
ME_PORT=8585
AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_URL=http://localhost
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
RUSTFS_ACCESS_KEY=elearningfsadmin
RUSTFS_SECRET_KEY=elearningfsadmin-secret
RUSTFS_BUCKET=e-learning-msc
RUSTFS_REGION=us-east-1
# Visitor analytics — IPstack key is read at runtime, never baked into the image
IPSTACK_ACCESS_KEY=
ANALYTICS_ENABLED=true