# The only tracked env file in this repo — it documents every variable the app reads.
# Copy it; never edit a real env file in git:
#   local dev  -> cp .env.example .env.local   (gitignored, loaded by Next.js)
#   Docker/VPS -> cp .env.example .env         (gitignored, auto-loaded by docker compose)
# docker compose reads ./.env on its own, so `--env-file` is only needed for a custom name.
# NEVER commit a file that contains real secrets.
#
# Environment overrides — everything else below is identical everywhere:
#   AUTH_URL              dev: http://localhost:3000   VPS: https://e-teaching.tech
#   DOMAIN                VPS only (nginx.prod.conf.template)
#   ANALYTICS_TRUST_PROXY false when hitting the app directly, true behind the nginx proxy
#   MONGODB_URI / RUSTFS_ENDPOINT
#                         localhost URLs in .env.local; the compose files override them
#                         with the in-network service names (mongo, rustfs)

# App
NODE_ENV=development
APP_PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/e-learning-msc

# Auth
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Seed
SEED_PASSWORD=password123

# RustFS (S3-compatible object storage)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_BUCKET=e-learning-msc
RUSTFS_ACCESS_KEY=elearningfsadmin
RUSTFS_SECRET_KEY=elearningfsadmin-secret
RUSTFS_REGION=us-east-1

# Docker Compose ports
HTTP_PORT=80
HTTPS_PORT=443
ME_PORT=8585
ME_USER=admin
ME_PASSWORD=admin
RUSTFS_S3_PORT=9200
RUSTFS_CONSOLE_PORT=9201

# Public domain, production only (nginx.prod.conf.template renders the server block)
DOMAIN=e-teaching.tech

# ----------------------------------------------------------------------------
# Visitor analytics (first-party, admin-only at /admin/analytics)
# ----------------------------------------------------------------------------
# Server-only IPstack key. Never add a NEXT_PUBLIC_ prefix — the secret must not
# reach the browser bundle. Rotate from the APILayer dashboard.
IPSTACK_ACCESS_KEY=
IPSTACK_BASE_URL=https://api.ipstack.com
# Per-request timeout and geolocation cache lifetime.
IPSTACK_TIMEOUT_MS=3000
IPSTACK_CACHE_TTL_HOURS=168
# Shorter retry window applied after a failed lookup so quota is not burned.
IPSTACK_FAILURE_BACKOFF_MINUTES=60

# Master switch. Set to false to stop collection entirely.
ANALYTICS_ENABLED=true
# HMAC key for pseudonymous visitor and IP hashing. Falls back to AUTH_SECRET if empty.
ANALYTICS_HASH_SECRET=
# Retention in days. Drives both the TTL index and scripts/purge-analytics.ts.
ANALYTICS_RETENTION_DAYS=90
# Inactivity window that ends a visit.
ANALYTICS_SESSION_WINDOW_MINUTES=30
# Timezone used to bucket report days. Storage is always UTC.
ANALYTICS_REPORTING_TZ=UTC
# Exclude signed-in administrators from reports by default.
ANALYTICS_EXCLUDE_ADMINS=true
# Only enable when the app is fronted by a reverse proxy you control (nginx sets
# X-Real-IP to the real peer). Set to false when hitting the app directly.
ANALYTICS_TRUST_PROXY=false
# Ingestion guards.
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
ANALYTICS_MAX_EVENTS_PER_REQUEST=10
ANALYTICS_MAX_BODY_BYTES=16384
# Hard cap on any dashboard date range.
ANALYTICS_MAX_RANGE_DAYS=90